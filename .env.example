OPENAI_API_KEY=hogehoge
DISCORD_WEBHOOK_URL=hogehoge
DATABASE_URL=sqlite:////app/data/sales.db
DISCOVERY_MODEL=gpt-5.6-luna
SCORING_MODEL=gpt-5.6-luna
STRATEGY_MODEL=gpt-5.6-terra
# Reasoning effort is model-dependent. Leave Scoring/Strategy blank to use each model's default.
DISCOVERY_REASONING_EFFORT=xhigh
SCORING_REASONING_EFFORT=
STRATEGY_REASONING_EFFORT=
# V2 cost ladder: source collection -> local fixed discovery -> cheap WIN -> diagnostic research.
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MAX_EVENTS_PER_SOURCE=20
FIXED_DISCOVERY_MODEL=gpt-5.6-luna
FIXED_DISCOVERY_REASONING_EFFORT=medium
FIXED_DISCOVERY_BATCH_SIZE=20
SOURCE_PREFILTER_BATCH_SIZE=100
FIXED_DISCOVERY_INCLUDE_HOLD_EVENTS=true
ATPRESS_PREFILTER_PASS_SCORE=2
ATPRESS_PREFILTER_DROP_SCORE=-1
CHEAP_WIN_MODEL=gpt-5.6-luna
CHEAP_WIN_REASONING_EFFORT=low
WIN_PRE_DROP_THRESHOLD=3.5
WIN_PRE_DIAGNOSTIC_THRESHOLD=5.5
DIAGNOSTIC_MODEL=gpt-5.6-terra
DIAGNOSTIC_REASONING_EFFORT=medium
DIAGNOSTIC_WEB_SEARCH=true
PEER_RESEARCH_ENABLED=false
DIAGNOSTIC_INCLUDE_HOLD=false
V2_GENERATE_STRATEGY=false
TIMEZONE=Asia/Tokyo
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
TOP_CANDIDATES=5
LOG_LEVEL=INFO
DISCOVERY_PROMPT_VERSION=v6
SCORING_PROMPT_VERSION=v6
STRATEGY_PROMPT_VERSION=v1
# Optional: PROMPTS_DIR, OPENAI_TIMEOUT_SECONDS (120), STRATEGY_WEB_SEARCH (false)
# Linux bind-mount permissions: set LOCAL_UID / LOCAL_GID to your uid / gid if needed.
LOCAL_UID=1000
LOCAL_GID=1000
